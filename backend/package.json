{
  "name": "yapha-lms-backend",
  "version": "0.9.1",
  "private": true,
  "description": "Yapha LMS API: multitenant e-learning platform by Mwanga Limited.",
  "author": {
    "name": "Mwanga Limited",
    "email": "tech@mwanga.ng",
    "url": "https://mwanga.ng"
  },
  "license": "UNLICENSED",
  "homepage": "https://yaphaacademy.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mwanga-Limited/yapha-lms.git",
    "directory": "backend"
  },
  "bugs": {
    "email": "tech@mwanga.ng"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch-path=src --watch-preserve-output src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/scripts/migrate.js",
    "seed:superadmin": "node src/scripts/seed-superadmin.js",
    "seed:demo": "node src/scripts/seed-demo.js",
    "brand:yapha": "node src/scripts/brand-yapha.js",
    "test": "node --test --test-concurrency=1 --test-reporter=spec test/rules.test.js test/files-totp.test.js test/tenancy.test.js test/payments.test.js test/hardening.test.js test/cloud.test.js test/referrals.test.js test/course-slugs.test.js",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude=test/** test/rules.test.js test/files-totp.test.js test/tenancy.test.js test/payments.test.js test/hardening.test.js test/referrals.test.js test/course-slugs.test.js",
    "secrets:encrypt-totp": "node src/scripts/encrypt-totp-secrets.js",
    "reset:superadmin-2fa": "node src/scripts/reset-superadmin-2fa.js",
    "files:to-gcs": "node src/scripts/migrate-files-to-gcs.js",
    "backup": "node src/scripts/backup.js",
    "outbox:worker": "node src/scripts/outbox-worker.js"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "@logtail/node": "^0.6.1",
    "@sentry/node": "^11.16.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "otplib": "^13.6.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
