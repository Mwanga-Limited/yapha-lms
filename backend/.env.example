# Copy to backend/.env for local development. Never commit the real file.
# Production does NOT use this file: on Google Cloud Terraform sets these as Cloud Run environment variables and secrets
# (see deploy/gcp/RUNBOOK.md); on a single server use deploy/.env.production.example with docker compose.
# Lines starting with "#" are optional. Everything below works out of the box locally except where it says REQUIRED.

# ============================================================ Basics
NODE_ENV=development
PORT=4000                    # Cloud Run and the Docker image use 8080
APP_URL=http://localhost:5173   # the address people open (used in email links). Production: https://your.domain
SESSION_HOURS=12
COOKIE_SECURE=false          # production: true (the default when NODE_ENV=production)
# Behind a reverse proxy / Cloud Run: the NUMBER of proxies in front of the app. Direct Cloud Run = 1;
# behind your own load balancer in front of Cloud Run = 2. A wrong value lets clients fake their IP and dodge rate limits.
# TRUST_PROXY=1

# ============================================================ Database (PostgreSQL 13+; production uses 17)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/yapha_lms
# Direct (unpooled) connection, for work a connection pooler breaks: migrations, pg_dump backups, restores.
# Only needed if DATABASE_URL goes through a pooler (e.g. Neon's -pooler host: use the same URL without "-pooler" here). Falls back to DATABASE_URL.
# DATABASE_URL_UNPOOLED=
# Optional, local only: a login role that can be used instead of the superuser (see README). Leave empty normally.
APP_DB_USER=
# Connections per app instance. (DB_POOL_MAX x maximum instances) must stay well under the database's max_connections.
# DB_POOL_MAX=10
# Separate database used by `npm test`. It is ERASED on every run, and its name must contain "test".
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/yapha_lms_test

# ============================================================ Secrets (REQUIRED in production)
# Random, 32+ characters, never the placeholder:   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
# Encrypts authenticator-app (TOTP) secrets in the database. 32 random bytes, base64:   openssl rand -base64 32
# Development derives a key from JWT_SECRET when this is empty; PRODUCTION REFUSES TO START WITHOUT IT.
# Back it up with your other secrets: if it is lost, users with an authenticator app cannot sign in with it.
TOTP_ENCRYPTION_KEY=
# Only while rotating the key: put the OLD key here, the new one above, deploy, run `npm run secrets:encrypt-totp`, then remove this.
# TOTP_ENCRYPTION_KEY_PREVIOUS=

# ============================================================ Email
# console = print emails in the backend terminal (default locally), smtp = real delivery (REQUIRED in production), memory = tests
MAIL_TRANSPORT=console
# Resend (https://resend.com): SMTP_HOST=smtp.resend.com, SMTP_USER=resend, SMTP_PASS=<your Resend API key, re_...>.
# Port 465 with SMTP_SECURE=true (implicit TLS), or port 587 with SMTP_SECURE=false (STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false            # true for port 465
SMTP_USER=
SMTP_PASS=
# The address must be on a domain verified in Resend (Domains > Add domain; publish its SPF and DKIM records).
MAIL_FROM="Yapha <no-reply@yapha.com>"
# Production: publish SPF, DKIM and DMARC for the domain in MAIL_FROM (your SMTP provider tells you the records),
# otherwise invitations and sign-in codes land in spam. See deploy/gcp/RUNBOOK.md.
#
# Emails are written to a database queue (email_outbox) and sent right after each request. Anything that fails is retried
# (1, 5, 30, 120, 720 minutes). Something has to run the retries:
#   - Google Cloud: Cloud Scheduler calls /api/internal/outbox/drain every minute (see INTERNAL_* below)
#   - anywhere else with MAIL_TRANSPORT=smtp: run `npm run outbox:worker` (docker compose does this for you)

# ============================================================ File storage
# disk = a folder (local development, one server). gcs = Google Cloud Storage (REQUIRED on Cloud Run, which has no durable disk).
STORAGE_DRIVER=disk
UPLOAD_DIR=uploads           # used when STORAGE_DRIVER=disk
# GCS_BUCKET=                # the uploads bucket, when STORAGE_DRIVER=gcs. Credentials come from the Cloud Run service account
#                            # (no key files). Locally: `gcloud auth application-default login`. The account needs
#                            # objectAdmin on the bucket AND roles/iam.serviceAccountTokenCreator on itself (to sign addresses).
#                            # The bucket needs CORS allowing PUT from APP_URL (Terraform sets it).

# ============================================================ Rate limits and abuse limits
# memory = per process (fine locally and for one instance). postgres = shared by every instance (default in production).
# RATE_LIMIT_STORE=memory
AUTH_RATE_LIMIT_MAX=100      # sign-in style actions per network address and organisation per 15 min (page-load reads are not counted)
LOGIN_MAX_FAILURES=5
UPLOADS_PER_HOUR=60          # uploads per signed-in user per hour
ORG_STORAGE_MB=5120          # total uploaded files per organisation
INVITES_PER_DAY=50           # invitations an organisation may send per 24 h
NEW_ORG_INVITES_PER_DAY=5    # ... during its first 24 h
# (Fixed in code: one email address can be invited at most 3 times a day and 10 times in 30 days, across ALL organisations.)

# ============================================================ Sign-up and accounts
ORG_SIGNUP=open              # open | closed: can new organisations register themselves at /register
ORG_SIGNUP_PER_HOUR=5
GOOGLE_CLIENT_ID=            # optional Google sign-in (OAuth client ID of type "Web application")

# Platform super admin: created once by `npm run seed:superadmin`. Sees every organisation at /platform.
SUPERADMIN_EMAIL=tech@mwanga.ng
# Tests use SUPERADMIN_EMAIL/SUPERADMIN_PASSWORD too (test database only), unless you override them here:
# TEST_SUPERADMIN_EMAIL=
# TEST_SUPERADMIN_PASSWORD=
SUPERADMIN_PASSWORD=         # 12+ characters
SUPERADMIN_NAME="Platform Super Admin"

# Organisation self-registration (/register): open | closed, and registrations allowed per network per hour.
ORG_SIGNUP=open
ORG_SIGNUP_PER_HOUR=5

# Payments (Paystack). Each organisation enters its own Paystack keys in Admin > Settings > Payments.
# DATA_ENCRYPTION_KEY encrypts those keys in the database: use a long random value, keep it secret, never change it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=

# ============================================================ Operations
LOG_LEVEL=info               # debug | info | warn | error | silent. JSON lines (Google Cloud Logging reads `severity`)
# Better Stack log shipping (Telemetry > Sources > your Node.js source). Both required; off when empty.
# BETTERSTACK_SOURCE_TOKEN=
# BETTERSTACK_ERRORS_DSN=      # Errors > Applications > your Node.js app (backend). Reports unhandled 500s and crashes.
# BETTERSTACK_INGESTING_HOST=   # e.g. sXXXXXXX.region.betterstackdata.com (no https://)
# METRICS_TOKEN=             # set to enable GET /api/metrics (Authorization: Bearer <token>); off when empty. openssl rand -hex 24

# ============================================================ Google Cloud only (Terraform sets these on Cloud Run)
# Cloud Scheduler calls /api/internal/* with a Google-signed identity token. The app checks the token, this audience and this account.
# INTERNAL_AUDIENCE=https://learn.yapha.com                       # = APP_URL
# INTERNAL_INVOKER_EMAIL=yapha-scheduler@PROJECT.iam.gserviceaccount.com
# BACKUP_BUCKET=             # used by the nightly backup job (`npm run backup`): the independent backup bucket
