NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/elearning
# Optional least-privilege role used at runtime; `npm run migrate` grants it rights (audit_logs: SELECT/INSERT only)
APP_DB_USER=
# Separate database used by npm test. It is ERASED on every run, and its name must contain "test".
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/elearning_test
JWT_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:5173
SESSION_HOURS=12
COOKIE_SECURE=false

# Email: smtp | console (prints emails in the terminal) | memory
MAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="E-Learning <no-reply@example.com>"

# Optional Google sign-in (OAuth client ID of type "Web application")
GOOGLE_CLIENT_ID=

UPLOAD_DIR=uploads
AUTH_RATE_LIMIT_MAX=100
LOGIN_MAX_FAILURES=5

# Platform super admin (created once by: npm run seed:superadmin). Sees every organisation at /platform.
# Organisations register themselves at /register; whoever registers becomes that organisation's first Admin.
SUPERADMIN_EMAIL=owner@example.com
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME="Platform Super Admin"

# Organisation self-registration (/register): open | closed, and registrations allowed per network per hour.
ORG_SIGNUP=open
ORG_SIGNUP_PER_HOUR=5

# Payments (Paystack). Each organisation enters its own Paystack keys in Admin > Settings > Payments.
# DATA_ENCRYPTION_KEY encrypts those keys in the database: use a long random value, keep it secret, never change it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=
