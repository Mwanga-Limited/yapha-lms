# Copy to deploy/.env.production (never commit it) and fill in every value.
POSTGRES_ADMIN_PASSWORD=
APP_DB_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32   (encrypts authenticator-app secrets; losing it locks those users out of 2FA, so back it up with the other secrets)
TOTP_ENCRYPTION_KEY=
# Only while rotating the key: the old value
TOTP_ENCRYPTION_KEY_PREVIOUS=
# openssl rand -base64 48   (encrypts each organisation's Paystack keys in the database; REQUIRED in production, never change it
# once set, or saved payment keys become unreadable. Back it up with the other secrets)
DATA_ENCRYPTION_KEY=
APP_URL=https://learn.yapha.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Yapha <no-reply@yapha.com>"
GOOGLE_CLIENT_ID=
# Number of reverse proxies in front of the app. 1 = a single load balancer / nginx. 0 = none (then never expose it publicly).
TRUST_PROXY=1
ORG_SIGNUP=open
# Set to enable /api/metrics (openssl rand -hex 24)
METRICS_TOKEN=

# ---- Optional: everything below has a safe default. Uncomment only to change it.
# debug | info | warn | error | silent (JSON lines)
# LOG_LEVEL=info
# Hours a sign-in lasts
# SESSION_HOURS=12
# Database connections per app instance (instances x this must stay under the database's max_connections)
# DB_POOL_MAX=10
# memory = per process, postgres = shared by every instance (the default in production)
# RATE_LIMIT_STORE=postgres

# Abuse limits
# AUTH_RATE_LIMIT_MAX=100        # sign-in style actions per network address and organisation per 15 minutes
# LOGIN_MAX_FAILURES=5
# ORG_SIGNUP_PER_HOUR=5          # organisation registrations per network address per hour
# UPLOADS_PER_HOUR=60            # uploads per signed-in user per hour
# ORG_STORAGE_MB=5120            # total uploaded files per organisation
# INVITES_PER_DAY=50             # invitations an organisation may send per 24 h
# NEW_ORG_INVITES_PER_DAY=5      # ... during its first 24 h

# Error and log shipping to Better Stack (both ingest values are needed for logs)
# BETTERSTACK_SOURCE_TOKEN=
# BETTERSTACK_INGESTING_HOST=    # e.g. sXXXXXXX.region.betterstackdata.com (no https://)
# BETTERSTACK_ERRORS_DSN=

# Only for the one-off `npm run seed:superadmin` (run it once, then remove the password from this file)
# SUPERADMIN_EMAIL=
# SUPERADMIN_NAME="Platform Super Admin"
# SUPERADMIN_PASSWORD=           # 12+ characters
